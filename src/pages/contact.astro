---
import copy from '../data/copy.json';
import pricing from '../data/pricing.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import { estimateDelivery } from '../lib/delivery.mjs';
// The public Turnstile site key is loaded from a Pages Function at runtime.
---
<BaseLayout title="MIXの依頼・相談｜ODOKENE"><div class="shell subpage"><div class="page-intro"><p class="small-label">ODOKENE</p><h1>MIXの依頼・相談</h1><p>{copy.contact.intro}</p></div>
<div class="contact-columns"><div><form id="mix-request" data-pricing={JSON.stringify(pricing)} method="post" action="/api/request" novalidate>
<p class="form-help">{copy.contact.formHelp}</p>
<div class="field"><label for="client-name">活動名・お名前 <span class="required">*</span></label><input id="client-name" name="name" autocomplete="nickname" required maxlength="90" placeholder="ハンドルネームでもOK"/></div>
<div class="field-row"><div class="field"><label for="reply-method">返信方法 <span class="required">*</span></label><select id="reply-method" name="replyMethod"><option value="x">XのDM</option><option value="email">メール</option></select></div><div class="field" id="x-field"><label for="x-handle">XのユーザーID <span class="required" id="x-required">*</span></label><input id="x-handle" name="xHandle" placeholder="@username" maxlength="80" required/></div></div>
<div class="field"><label for="client-email">メールアドレス <span class="optional" id="email-required">任意</span></label><input id="client-email" name="email" type="email" autocomplete="email" placeholder="example@email.com" maxlength="180"/><small>DMを選んだ場合、メールは予備の連絡先として任意です。</small></div>
<h2 class="form-heading">MIXの内容</h2>
<div class="field-row"><div class="field"><label for="plan">プラン <span class="required">*</span></label><select id="plan" name="plan" required><option value="one">ワンコーラス（{pricing.one.base.toLocaleString('ja-JP')}円）</option><option value="full">フルコーラス（{pricing.full.base.toLocaleString('ja-JP')}円）</option></select></div><div class="field"><label for="singers">ボーカル人数 <span class="required">*</span></label><select id="singers" name="singers" required>{Array.from({length:pricing.maxSingers},(_,i)=><option value={i+1}>{i+1}人</option>)}</select></div></div>
<div class="field-row"><div class="field"><label for="harmony">ハモリ（任意）</label><select id="harmony" name="harmony"><option value="none">なし</option><option value="generate">生成（＋{pricing.harmony.generate.toLocaleString('ja-JP')}円）</option><option value="arrange">作成・アレンジ（＋{pricing.harmony.arrange.toLocaleString('ja-JP')}円）</option></select></div><div class="field"><label for="rush">納期</label><select id="rush" name="rush"><option value="normal">通常（1名：{estimateDelivery(pricing,1,'normal')}）</option><option value="72h">お急ぎ（{estimateDelivery(pricing,1,'72h')}／1名＋{pricing.rush['72h'].toLocaleString('ja-JP')}円）</option><option value="24h">超特急（24時間希望／1名目安＋{pricing.rush['24h'].toLocaleString('ja-JP')}円・要相談）</option></select></div></div>
<div class="estimate" aria-live="polite"><span>概算料金（税込）</span><strong id="estimated-price">¥{pricing.one.base.toLocaleString('ja-JP')}</strong></div><div class="estimate-delivery" aria-live="polite"><span>初回納品の目安</span><strong id="estimated-delivery">{estimateDelivery(pricing,1,'normal')}</strong></div><p class="fine">人数による延長は通常のみ、1名追加ごとに＋{pricing.delivery.extraDaysPerSinger * 24}時間です。お急ぎは人数に関係なく72時間以内。お急ぎ・超特急の追加料金は人数分加算されます。超特急は1名あたり＋{pricing.rush['24h'].toLocaleString('ja-JP')}円を目安に計算しますが、正式な料金・納期は要相談。必要な素材が揃った時点から数えます。</p><p class="fine">正確な料金は、内容を確認してからお伝えします。</p>
<h2 class="form-heading">分かる範囲でご記入ください</h2>
<div class="field"><label for="song-title">曲名（任意）</label><input id="song-title" name="songTitle" maxlength="160"/></div>
<div class="field"><label for="materials-url">素材の共有URL（任意）</label><input id="materials-url" name="materialsUrl" type="url" maxlength="600" placeholder="https://..."/><small>{copy.contact.materialHelp}</small></div>
<div class="field"><label for="wish-date">希望納品日（任意）</label><input id="wish-date" name="wishDate" type="date"/></div>
<div class="field"><label for="message">ご相談・要望（任意）</label><textarea id="message" name="message" maxlength="2500" rows="5"></textarea></div>
<div class="visually-hidden" aria-hidden="true"><label for="company-url">空欄</label><input id="company-url" name="companyUrl" tabindex="-1" autocomplete="off"/></div>
<p class="fine">{copy.contact.privacyNote}</p>
<label class="agree"><input name="consent" type="checkbox" value="yes" required/> 上記を確認して送信します <span class="required">*</span></label>
<div id="turnstile-container"></div>
<p class="form-warning" id="form-warning" role="status">認証機能を読み込んでいます。</p>
<button type="submit" class="send-button" id="submit-request" disabled>フォーム送信は準備中</button>
<p class="contact-response" id="request-response" role="status" aria-live="polite"></p>
</form></div>
<aside class="contact-aside"><h2>XのDM</h2><p>{copy.contact.dmText}</p><p><a href="https://x.com/kigeki_odokene" target="_blank" rel="noopener noreferrer">@kigeki_odokene ↗</a></p><hr/><p class="fine">基本料金：{pricing.one.base.toLocaleString('ja-JP')}円〜<br/>通常納期（1名）：{estimateDelivery(pricing,1,'normal')}<br/>お支払い：最終納品後、銀行振込</p><p class="quiet-link"><a href="/faq/">注意事項を見る ↗</a></p></aside>
</div></div>

<script is:inline src="/js/contact.js" defer></script>
</BaseLayout>
