---
import copy from '../data/copy.json';
import pricing from '../data/pricing.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import { estimateDelivery } from '../lib/delivery.mjs';
---
<BaseLayout title="料金｜ODOKENE"><div class="shell subpage"><div class="page-intro"><p class="small-label">ODOKENE</p><h1>料金</h1><p>{copy.price.intro}</p></div>
<section class="subsection"><div class="section-aside"><h2>基本料金</h2></div><div class="section-body"><div class="primary-prices"><div><span>ワンコーラスMIX</span><strong>{pricing.one.base.toLocaleString('ja-JP')}<small>円</small></strong></div><div><span>フルコーラスMIX</span><strong>{pricing.full.base.toLocaleString('ja-JP')}<small>円</small></strong></div></div><p class="fine">{copy.price.baseNote}</p></div></section>
<section class="subsection"><div class="section-aside"><h2>追加料金</h2></div><div class="section-body"><dl class="small-rates"><div><dt>ボーカル追加（ワンコーラス・1名）</dt><dd>＋{pricing.one.extraSinger.toLocaleString('ja-JP')}円</dd></div><div><dt>ボーカル追加（フルコーラス・1名）</dt><dd>＋{pricing.full.extraSinger.toLocaleString('ja-JP')}円</dd></div><div><dt>ハモリ生成</dt><dd>＋{pricing.harmony.generate.toLocaleString('ja-JP')}円</dd></div><div><dt>動画エンコード（許諾済み素材・1本）</dt><dd>＋{pricing.video.encode.toLocaleString('ja-JP')}円</dd></div><div><dt>お急ぎ（72時間・1人あたり）</dt><dd>＋{pricing.rush['72h'].toLocaleString('ja-JP')}円</dd></div><div><dt>超特急（24時間希望・1人あたり・要相談）</dt><dd>目安 ＋{pricing.rush['24h'].toLocaleString('ja-JP')}円</dd></div></dl><p class="fine">{copy.price.optionsNote}</p><p class="fine">人数による納期延長は<strong>通常のみ：追加1名につき＋{pricing.delivery.extraDaysPerSinger * 24}時間</strong>です。お急ぎの初回納品は人数にかかわらず72時間以内、追加料金は1名につき＋{pricing.rush['72h'].toLocaleString('ja-JP')}円です。超特急（24時間希望）は1名につき目安＋{pricing.rush['24h'].toLocaleString('ja-JP')}円で、正式な料金・納期・対応可否は要相談です。納期は必要な素材がすべて揃った時点から数えます。</p></div></section>
<section class="subsection" id="estimate">
  <div class="section-aside"><h2>概算計算</h2><p class="aside-hint">人数に応じた料金と納期を確認できます。</p></div>
  <div class="section-body">
    <form id="price-calculator" class="price-calculator" data-pricing={JSON.stringify(pricing)}>
      <div class="calc-fields">
        <div class="field"><label for="calc-plan">プラン</label><select id="calc-plan" name="plan">
          <option value="one">ワンコーラス</option>
          <option value="full">フルコーラス</option>
        </select></div>
        <div class="field"><label for="calc-singers">ボーカル人数</label><select id="calc-singers" name="singers">
          {Array.from({length:pricing.maxSingers}, (_,i) => <option value={i+1}>{i+1}人</option>)}
        </select></div>
        <div class="field"><label for="calc-harmony-select">ハモリ</label><select id="calc-harmony-select" name="harmony">
          <option value="none">なし</option>
          <option value="generate">ハモリ生成（＋{pricing.harmony.generate.toLocaleString('ja-JP')}円）</option>
                  </select></div>
        <div class="field"><label for="calc-video-select">動画納品</label><select id="calc-video-select" name="video">
          <option value="none">なし（音声ファイルのみ）</option>
          <option value="encode">音源差し替え・書き出し（＋{pricing.video.encode.toLocaleString('ja-JP')}円／本）</option>
        </select></div>
        <div class="field"><label for="calc-rush-select">納期</label><select id="calc-rush-select" name="rush">
          <option value="normal">通常（1名：{estimateDelivery(pricing,1,'normal')}）</option>
          <option value="72h">お急ぎ（{estimateDelivery(pricing,1,'72h')}／1名＋{pricing.rush['72h'].toLocaleString('ja-JP')}円）</option>
          <option value="24h">超特急（24時間希望／1名目安＋{pricing.rush['24h'].toLocaleString('ja-JP')}円・要相談）</option>
        </select></div>
      </div>
      <div class="calc-summary" aria-live="polite" aria-atomic="true">
        <p class="calc-selected" id="calc-selection">ワンコーラス / 1人 / なし / 通常（7〜14日）</p>
        <dl class="calc-breakdown">
          <div><dt>基本料金</dt><dd id="calc-base">¥{pricing.one.base.toLocaleString('ja-JP')}</dd></div>
          <div id="calc-extra-singers-row" hidden><dt>追加ボーカル</dt><dd id="calc-extra-singers">¥0</dd></div>
          <div id="calc-harmony-row" hidden><dt>ハモリ</dt><dd id="calc-harmony">¥0</dd></div>
          <div id="calc-rush-row" hidden><dt>お急ぎ・超特急</dt><dd id="calc-rush">¥0</dd></div>
          <div id="calc-video-row" hidden><dt>動画エンコード</dt><dd id="calc-video">¥0</dd></div>
        </dl>
        <div class="calc-total"><span>概算合計（税込）</span><strong id="calc-total">¥{pricing.one.base.toLocaleString('ja-JP')}</strong></div>
        <div class="calc-delivery">
          <span>初回納品の目安</span>
          <strong id="calc-delivery">{estimateDelivery(pricing,1,'normal')}</strong>
          <small id="calc-delivery-extra">ボーカル1名の場合の目安</small>
        </div>
      </div>
      <p class="fine">動画エンコードは権利処理済み映像に限ります。公式MVなどの第三者映像は、編集・納品について必要な許諾がある場合のみ対応します。許諾が確認できない場合はお引き受けできません。</p>
      <p class="fine">表示金額はすべて概算です。超特急も1名あたり＋{pricing.rush['24h'].toLocaleString('ja-JP')}円を目安に人数分計算しますが、正式な料金・納期・対応可否は個別にご案内します。</p>
      <div class="calc-actions">
        <a id="calc-request-link" class="calc-request-link" href="/contact/?plan=one&amp;singers=1&amp;harmony=none&amp;rush=normal">この内容で相談する ↗</a>
        <button class="calc-copy-button" id="calc-copy" type="button">計算内容をコピー</button>
      </div>
      <p class="calc-copy-status" id="calc-copy-result" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
<section class="subsection"><div class="section-aside"><h2>料金の例</h2></div><div class="section-body"><ul class="plain-lines"><li>フルコーラス／ソロ　<strong>{pricing.full.base.toLocaleString('ja-JP')}円</strong></li><li>フルコーラス／2人　<strong>{(pricing.full.base + pricing.full.extraSinger).toLocaleString('ja-JP')}円</strong></li><li>ワンコーラス／3人　<strong>{(pricing.one.base + pricing.one.extraSinger*2).toLocaleString('ja-JP')}円</strong></li></ul></div></section>
<section class="subsection"><div class="section-aside"><h2>お支払い</h2></div><div class="section-body"><p>{copy.price.payment}</p><p class="quiet-link"><a href="#estimate">概算料金を計算する ↗</a></p></div></section>
</div></BaseLayout>

<script is:inline src="/js/price-calculator.js" defer></script>
