---
import copy from '../data/copy.json';
import pricing from '../data/pricing.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import works from '../data/works.json';
import WorkPlayer from '../components/WorkPlayer.astro';
import homeSettings from '../data/home-settings.json';
import { getWorkVideo, workCreditText } from '../lib/work-video.mjs';
const allWorks = works.works || [];
const featured = allWorks.find(w => w.featured) ?? allWorks[0];
const orderedWorks = featured ? [featured, ...allWorks.filter(w => w !== featured)] : [];
const displayCount = [1, 3, 4].includes(Number(homeSettings.displayCount)) ? Number(homeSettings.displayCount) : 1;
const selectedWorks = orderedWorks.slice(0, displayCount);

---
<BaseLayout title="ODOKENE｜歌ってみたMIXのご依頼">
<div class="shell homepage">
  <div class="hello-area">
    <div class="hello-copy">
      <h1>{copy.home.title}</h1>
      <p class="intro">{copy.home.intro1}</p>
      <p class="intro">{copy.home.intro2a}<br/>{copy.home.intro2b}</p>
      <p class="intro-link"><a href="/contact/">依頼フォーム</a><a href="https://x.com/kigeki_odokene" target="_blank" rel="noopener noreferrer">XのDM</a></p>
    </div>
    <section class="hello-work" id="works">
      <div class="piece-top"><h2>{copy.home.worksTitle}</h2><a href="/works/">一覧を見る</a></div>
      {selectedWorks.length > 0 && <div class="home-work-rotator" data-interval="8000" data-autoplay={homeSettings.autoRotate !== false ? "true" : "false"} aria-label="制作実績">
        <div class="home-work-slides">
          {selectedWorks.map((work, index) => {
            const video = getWorkVideo(work);
            const credit = workCreditText(work);
            return <div class="featured-row" data-featured-slide hidden={index !== 0}>
              <a href={video.url || '#'} class="work-visual js-work-play" data-video-platform={video.type} data-video-id={video.id || ''} data-video-title={work.title} target="_blank" rel="noopener noreferrer" aria-label={`${work.title}の動画を再生する`}>
                <div class="work-fallback">
                  <span class="work-fallback-label">{video.label}</span>
                  <span class="work-fallback-title">{work.title}</span>
                  <span class="work-fallback-credit">歌：{work.cover}</span>
                </div>
                {video.thumb && <img src={video.thumb} alt={`${work.title}のサムネイル`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" onerror="this.hidden=true"/>}
                <span class="thumb-play" aria-hidden="true">▶</span>
              </a>
              <div class="featured-info">
                <h3>{work.title}</h3>
                <p>原曲：{work.original}</p>
                <p>歌：{work.cover}</p>
                {credit && <p>担当：{credit}</p>}
                <p><a class="js-work-play" href={video.url || '#'} data-video-platform={video.type} data-video-id={video.id || ''} data-video-title={work.title} target="_blank" rel="noopener noreferrer">{video.label}で見る</a></p>
              </div>
            </div>;
          })}
        </div>
        {selectedWorks.length > 1 && <div class="featured-rotation-controls">
          <div class="featured-rotation-arrows">
            <button type="button" data-slide-prev aria-label="前の作品">‹</button>
            <span class="featured-rotation-count" data-slide-count>1 / {selectedWorks.length}</span>
            <button type="button" data-slide-next aria-label="次の作品">›</button>
            {homeSettings.autoRotate !== false && <button type="button" data-slide-pause aria-label="自動切り替えを一時停止" aria-pressed="false" title="自動切り替えを一時停止">Ⅱ</button>}
          </div>
          <div class="featured-rotation-dots" role="group" aria-label="作品を選択">
            {selectedWorks.map((work, i) => <button type="button" data-slide-index={i} aria-label={`${i + 1}番目の作品：${work.title}を表示`} aria-current={i === 0 ? 'true' : undefined} title={work.title}>{i + 1}</button>)}
          </div>
        </div>}
      </div>}
    </section>
  </div>
  <section class="home-part rates" id="price">
    <div class="section-aside"><h2>{copy.home.ratesTitle}</h2><p class="aside-hint">{copy.home.ratesLabel}</p></div>
    <div class="section-body">
      <div class="primary-prices"><div><span>ワンコーラス</span><strong>{pricing.one.base.toLocaleString('ja-JP')}<small>円</small></strong></div><div><span>フルコーラス</span><strong>{pricing.full.base.toLocaleString('ja-JP')}<small>円</small></strong></div></div>
      <p class="fine">{copy.home.ratesNote}</p>
      <h3 class="minor-head">{copy.home.optionsTitle}</h3>
      <dl class="small-rates"><div><dt>ボーカル追加（ワンコーラス・1名）</dt><dd>＋{pricing.one.extraSinger.toLocaleString('ja-JP')}円</dd></div><div><dt>ボーカル追加（フルコーラス・1名）</dt><dd>＋{pricing.full.extraSinger.toLocaleString('ja-JP')}円</dd></div><div><dt>ハモリ生成</dt><dd>＋{pricing.harmony.generate.toLocaleString('ja-JP')}円</dd></div><div><dt>動画エンコード（権利処理済み素材・1本）</dt><dd>＋{pricing.video.encode.toLocaleString('ja-JP')}円</dd></div><div><dt>お急ぎ（72時間・1人あたり）</dt><dd>＋{pricing.rush['72h'].toLocaleString('ja-JP')}円</dd></div><div><dt>超特急（24時間希望・1人あたり・要相談）</dt><dd>目安 ＋{pricing.rush['24h'].toLocaleString('ja-JP')}円</dd></div></dl>
      <p class="quiet-link"><a href="/price/#estimate">料金の詳細・概算計算</a></p>
    </div>
  </section>
  <section class="home-part flow-part" id="flow">
    <div class="section-aside"><h2>{copy.home.flowTitle}</h2></div>
    <div class="section-body"><ol class="steps">{copy.home.flowSteps.map((step,i)=><li><span class="step-number">{i+1}</span><div><b>{step.title}</b><p>{step.text}</p></div></li>)}</ol>
    <p class="quiet-link"><a href="/flow/">依頼の流れ</a></p><p class="fine">人数による納期延長は通常のみ、追加1名につき＋{pricing.delivery.extraDaysPerSinger * 24}時間。お急ぎは人数にかかわらず72時間以内。お急ぎ・超特急の追加料金はボーカル人数分加算。超特急は正式な料金・納期が要相談。<a href="/price/#estimate">人数別の納期を確認する</a></p></div>
  </section>
  <section class="home-part notes-part">
    <div class="section-aside"><h2>{copy.home.notesTitle}</h2></div>
    <div class="section-body"><p>{copy.home.notes1}</p><p class="fine">{copy.home.notes2}</p><p class="quiet-link"><a href="/faq/">注意事項・よくある質問</a></p></div>
  </section>
  <section class="home-part last-part"><div class="section-aside"><h2>{copy.home.contactTitle}</h2></div><div class="section-body"><p>{copy.home.contact1}<br/>{copy.home.contact2}</p><p class="end-links"><a href="/contact/">依頼フォーム</a><a href="https://x.com/kigeki_odokene" target="_blank" rel="noopener noreferrer">XのDM（@kigeki_odokene）</a></p></div></section>
</div>
<WorkPlayer />
<script is:inline src="/js/home-work-rotation.js" defer></script>
</BaseLayout>
