---
import copy from '../data/copy.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import pricing from '../data/pricing.json';

---
<BaseLayout title="よくある質問・注意事項｜ODOKENE"><div class="shell subpage"><div class="page-intro"><p class="small-label">ODOKENE</p><h1>よくある質問</h1><p>{copy.faq.intro}</p></div>
<section class="subsection"><div class="section-aside"><h2>Q & A</h2></div><div class="section-body">{copy.faq.questions.map(item=><details class="faq-item"><summary>{item.question}</summary><p>{item.answer}</p></details>)}<p class="fine">納期はボーカル2人目以降、1名につき＋{pricing.delivery.extraDaysPerSinger}日です。<a href="/price/#estimate">料金・納期の概算を計算する</a></p></div></section>
<section class="subsection"><div class="section-aside"><h2>キャンセルについて</h2></div><div class="section-body"><p>{copy.faq.cancelText}</p><p class="fine">{copy.faq.cancelNote}</p></div></section>
<section class="subsection"><div class="section-aside"><h2>お問い合わせ</h2></div><div class="section-body"><p>{copy.faq.contactText}</p><p class="quiet-link"><a href="/contact/">お問い合わせはこちら ↗</a></p></div></section></div></BaseLayout>
