---
import { getWorkVideo, workCreditText } from '../lib/work-video.mjs';
const { work, size = 'regular' } = Astro.props;
const video = getWorkVideo(work);
const credit = workCreditText(work);
---
<article class:list={['work-entry',size === 'small' && 'work-entry--small']}>
  <a class="work-visual js-work-play" href={video.url || '#'} data-video-platform={video.type} data-video-id={video.id || ''} data-video-title={work.title} target="_blank" rel="noopener noreferrer" aria-label={`${work.title}の動画を再生する`}>
    <div class="work-fallback">
      <span class="work-fallback-label">{video.label}</span>
      <span class="work-fallback-title">{work.title}</span>
      <span class="work-fallback-credit">歌：{work.cover}</span>
    </div>
    {video.thumb && <img src={video.thumb} alt={`${work.title}のサムネイル`} loading="lazy" decoding="async" onerror="this.hidden=true"/>}
    <span class="thumb-play" aria-hidden="true">▶</span>
  </a>
  <p class="song-title">{work.title} <a class="song-link js-work-play" href={video.url || '#'} data-video-platform={video.type} data-video-id={video.id || ''} data-video-title={work.title} target="_blank" rel="noopener noreferrer">{video.label}で見る ↗</a></p>
  <p class="song-caption">原曲：{work.original} ／ 歌：{work.cover}</p>
  {credit && <p class="song-credit">担当：{credit}</p>}
</article>
