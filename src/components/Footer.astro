---
import copy from '../data/copy.json';
import site from '../data/site.json';
const dmHandle = '@' + site.xHandle.replace(/^@/, '');
const dmUrl = `https://x.com/${dmHandle.slice(1)}`;
---
<footer class="site-foot"><div class="shell foot-inner"><a href="/" class="foot-logo">odokene.</a><p>{copy.footer.before} <a href="/contact/">フォーム</a> または <a href={dmUrl} target="_blank" rel="noopener noreferrer">XのDM（{dmHandle}）</a> {copy.footer.after}</p><small>奇劇 / kigeki</small></div></footer>
