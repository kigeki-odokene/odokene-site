<dialog class="work-player-dialog" id="work-player" aria-label="動画プレイヤー">
  <div class="work-player-panel">
    <div class="work-player-head">
      <strong id="work-player-title"></strong>
      <form method="dialog"><button class="work-player-close" aria-label="閉じる" type="submit">閉じる ×</button></form>
    </div>
    <div class="work-player-content" id="work-player-content"></div>
    <p class="work-player-external"><a id="work-player-link" target="_blank" rel="noopener noreferrer">元の動画を開く ↗</a></p>
  </div>
</dialog>
<script is:inline src="/js/works-player.js" defer></script>
